<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="upi.controller.FormController">
   <top>
      <HBox spacing="16" styleClass="header">
         <children>
            <Label styleClass="title" text="Daftar Produk toko" />
            <Button onAction="#bukaCatalog" text="Lihat Catalog" />
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true">
         <content>
            <VBox spacing="16" styleClass="page">
               <children>
                  <VBox spacing="12" styleClass="card">
                     <children>
                        <Label styleClass="subtitle" text="Daftar Produk Baru" />
                        <Label text="Nama Produk" />
                        <TextField fx:id="namaField" promptText="Contoh: Nescafe" />
                        <Label text="Jenis produk" />
                        <ComboBox fx:id="jenisBox" maxWidth="Infinity" />
                        <Label styleClass="muted" text="Minuman Atau Makanan" wrapText="true" />
                        <Label text="Harga Produk" />
                        <TextField fx:id="HargaField" promptText="Rp" />
                        <Label text="Lampiran (Gambar Produk)" />
                        <ImageView fx:id="gambarView" fitHeight="160" fitWidth="280" preserveRatio="true" />
                        <Button onAction="#pilihGambar" text="Pilih Gambar" />
                        <Label styleClass="muted" text="PNG/JPEG, maksimal 5 MB. File lokal, bukan upload ke server." wrapText="true" />
                        <Button maxWidth="Infinity" onAction="#tambahProduk" styleClass="button-primary" text="Simpan dan Lihat Detail" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
